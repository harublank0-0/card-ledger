generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth models (shape required by better-auth's Prisma adapter).
// Do not hand-edit columns; keep in sync when upgrading better-auth.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  paymentMethods PaymentMethod[]
  subscriptions  Subscription[]

  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]

  categories   Category[]
  transactions Transaction[]

  cardStatements    CardStatement[]
  statementPayments StatementPayment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domain models. See docs/database.md for conventions:
// - money = Int minor units + ISO 4217 currency (never floats)
// - date-only business values use @db.Date
// - financial history is archived, never hard-deleted (onDelete: NoAction, i.e. Restrict that still allows user cascade)
// ---------------------------------------------------------------------------

enum BillingUnit {
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model PaymentMethod {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String
  name             String
  issuer           String?
  /// Last four digits only. Full card numbers, CVV and PIN are never stored.
  last4            String    @db.Char(4)
  currency         String    @db.Char(3)
  creditLimitMinor Int?
  /// Day of month the statement is generated (1-31, clamped to month length).
  statementDay     Int?
  /// Day of month the payment is due (1-31, clamped to month length).
  paymentDueDay    Int?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  transactions  Transaction[]
  statements    CardStatement[]

  @@index([userId, archivedAt])
  @@map("payment_method")
}

model Subscription {
  id                   String             @id @default(uuid(7)) @db.Uuid
  userId               String
  paymentMethodId      String?            @db.Uuid
  name                 String
  amountMinor          Int
  currency             String             @db.Char(3)
  /// Billing every `intervalCount` x `intervalUnit` (quarterly = 3 MONTH).
  intervalCount        Int                @default(1)
  intervalUnit         BillingUnit
  /// A known billing date; every renewal is derived from it (never chained).
  anchorDate           DateTime           @db.Date
  status               SubscriptionStatus @default(ACTIVE)
  autoRenew            Boolean            @default(true)
  expiresOn            DateTime?          @db.Date
  cancellationDeadline DateTime?          @db.Date
  cancelledOn          DateTime?          @db.Date
  notes                String?
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction)
  transactions  Transaction[]

  @@index([userId, status])
  @@index([userId, paymentMethodId])
  @@map("subscription")
}

enum NotificationKind {
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_EXPIRY
  CANCELLATION_DEADLINE
  CARD_PAYMENT_DUE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationPreference {
  id                  String   @id @default(uuid(7)) @db.Uuid
  userId              String   @unique
  /// IANA time zone name; decides what "today" means for reminders.
  timezone            String   @default("Asia/Kathmandu")
  emailEnabled        Boolean  @default(true)
  /// Days before an event to remind (0 = on the day). Default 7, 3 and 1.
  offsetsDays         Int[]    @default([7, 3, 1])
  renewalEnabled      Boolean  @default(true)
  expiryEnabled       Boolean  @default(true)
  cancellationEnabled Boolean  @default(true)
  paymentDueEnabled   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

/// One row per reminder (event + threshold). The unique key makes sending idempotent:
/// a row is claimed before an email is sent, so overlapping runs cannot double-send.
/// `entityId` is deliberately not a foreign key: the log must survive archiving.
model NotificationLog {
  id            String             @id @default(uuid(7)) @db.Uuid
  userId        String
  kind          NotificationKind
  entityId      String             @db.Uuid
  /// The date being reminded about (renewal date, expiry date, ...).
  eventDate     DateTime           @db.Date
  /// The threshold bucket (7, 3, 1, 0 days before).
  offsetDays    Int
  channel       String             @default("email")
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  /// Short failure reason; never contains financial details.
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId, eventDate, offsetDays, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_log")
}

enum TransactionType {
  EXPENSE
  REFUND
}

model Category {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String
  name       String
  /// Archived categories stay on historical transactions but are hidden from pickers.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("category")
}

/// Money that was actually spent (EXPENSE) or given back (REFUND). A refund always points at
/// the expense it reverses. An expected subscription renewal is never stored here; it only
/// becomes a transaction when the user records the real charge.
model Transaction {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String
  type            TransactionType
  /// Always positive; direction comes from `type`.
  amountMinor     Int
  /// Currency of the charge itself (may differ from the card's currency).
  currency        String          @db.Char(3)
  occurredOn      DateTime        @db.Date
  description     String
  notes           String?
  categoryId      String?         @db.Uuid
  paymentMethodId String?         @db.Uuid
  /// Set when the user records the real charge of a tracked subscription.
  subscriptionId  String?         @db.Uuid
  /// REFUND -> the EXPENSE it reverses (enforced by a CHECK constraint and the service).
  refundOfId      String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: NoAction)
  refundOf      Transaction?   @relation("Refunds", fields: [refundOfId], references: [id], onDelete: NoAction)
  refunds       Transaction[]  @relation("Refunds")

  @@index([userId, occurredOn])
  @@index([userId, paymentMethodId, occurredOn])
  @@index([userId, categoryId, occurredOn])
  @@index([refundOfId])
  @@map("transaction")
}

/// What the bank says is owed for one billing period. Entered from the bank's statement and
/// never derived from manually entered transactions. Currency always equals the card's.
model CardStatement {
  id                    String   @id @default(uuid(7)) @db.Uuid
  userId                String
  paymentMethodId       String   @db.Uuid
  periodStart           DateTime @db.Date
  periodEnd             DateTime @db.Date
  dueDate               DateTime @db.Date
  statementBalanceMinor Int
  minimumDueMinor       Int?
  currency              String   @db.Char(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod      @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction)
  payments      StatementPayment[]

  @@unique([paymentMethodId, periodStart, periodEnd])
  @@index([userId, dueDate])
  @@index([paymentMethodId, periodEnd])
  @@map("card_statement")
}

/// A payment toward a statement. Never counted as spending: paying the card bill is not an
/// expense. Its currency is the statement's currency.
model StatementPayment {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String
  statementId String   @db.Uuid
  amountMinor Int
  paidOn      DateTime @db.Date
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement CardStatement @relation(fields: [statementId], references: [id], onDelete: NoAction)

  @@index([userId, paidOn])
  @@index([statementId])
  @@map("statement_payment")
}
