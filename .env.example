# Card Ledger: settings for `docker compose up` (full guide: docs/self-hosting.md).
#
#   cp .env.example .env     then fill in the two required secrets below.
#
# .env holds secrets: never commit it. DATABASE_URL is built by compose.yaml from
# POSTGRES_PASSWORD, so it is not set here. (`npm run dev` reads .env.local instead.)

# ---- Required: compose refuses to start while these are empty ---------------------
# Generate with:  openssl rand -hex 24
# Hex avoids characters (/ @ : ?) that would break the database connection URL.
# Set it BEFORE the first start: changing it later does not change the existing database.
POSTGRES_PASSWORD=
# Generate with:  openssl rand -base64 48        (at least 32 characters)
BETTER_AUTH_SECRET=

# ---- Address ------------------------------------------------------------------------
# The address people type in the browser, scheme included. It must match exactly or
# sign-in is rejected. Cookies are marked Secure only when it starts with https://.
# Default: http://localhost:<APP_PORT>
# BETTER_AUTH_URL=https://ledger.example.com
# Port published on 127.0.0.1 (this machine only). Default 3000.
# APP_PORT=3000

# ---- Behaviour ----------------------------------------------------------------------
# first-user: only the first account can register (default). open: anyone. closed: nobody.
SIGNUP_MODE=first-user
# IANA time zone given to new users' reminder preferences (each user can change theirs).
# It must be a real IANA name such as Asia/Kathmandu or UTC; the app refuses to start otherwise.
DEFAULT_TIMEZONE=Asia/Kathmandu
# The /mcp endpoint is off. Leave it off unless you have a use for it; it still needs a session.
MCP_ENABLED=false

# ---- Email reminders (optional) -----------------------------------------------------
# Without SMTP_HOST reminders are off and everything else works normally.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Card Ledger <ledger@example.com>"
# true for implicit TLS (usually port 465); false for plain or STARTTLS (587).
# SMTP_SECURE=false
# STARTTLS is required for any relay that is not on this machine, so the SMTP password and the
# reminder text are never sent in the clear. Set false only for a plaintext relay on a network
# you trust (for example a mail catcher elsewhere on your LAN).
# SMTP_REQUIRE_TLS=true
# Seconds between reminder runs. Default 3600 (hourly).
# REMINDER_INTERVAL_SECONDS=3600
